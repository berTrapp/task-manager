# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings > API).

# Public project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable / anon key (safe to expose to the browser). Used for
# authentication (login sessions), never for data access — data access goes
# through the service role key below.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# Service role key. Server-only — never prefix with NEXT_PUBLIC_, never
# import it from a "use client" file, never commit it.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key
